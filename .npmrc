# Red corporativa con inspección TLS (proxy que reemplaza el certificado).
# Sin esto, npm falla con UNABLE_TO_VERIFY_LEAF_SIGNATURE y la instalación se cuelga.
#
# SOLUCIÓN RECOMENDADA (segura): pedir a sistemas el certificado de la CA interna
# y apuntarlo con la variable de entorno NODE_EXTRA_CA_CERTS=C:\ruta\ca-corporativa.crt
# Con eso podés borrar la línea de abajo.
#
# Mientras tanto, para desbloquear el desarrollo local:
strict-ssl=false

# Acelera la instalación en esta red
fund=false
audit=false
