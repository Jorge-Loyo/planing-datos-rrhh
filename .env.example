# Conexion a Neon Postgres.
# Copia este archivo como .env.local y pega aqui tu connection string de Neon.
# La encontras en el panel de Neon -> Connection Details -> Connection string.
# Importante: usa la cadena "pooled" (contiene -pooler) para la app.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar las sesiones (JWT). Genera uno largo y aleatorio.
# Podes generar uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
